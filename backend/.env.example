# ==============================================================================
# EideticAI Backend - Environment Variables Template
# ==============================================================================

# Server Configuration
PORT=5000
NODE_ENV=development
# Rate limiting is automatically active when NODE_ENV=production. Set to true to test locally.
ENABLE_RATE_LIMITER=false

# Primary & Fallback LLM Providers
GROQ_API_KEY=gsk_your_groq_api_key_here
GEMINI_API_KEY=your_gemini_api_key_here
OPENROUTER_API_KEY=sk-or-v1-your_openrouter_api_key_here

# Tavily Web Search API
TAVILY_API_KEY=tvly-your_tavily_api_key_here

# Qdrant Vector Cloud Database
QDRANT_URL=https://your-cluster-id.us-west-1-0.aws.cloud.qdrant.io
QDRANT_API_KEY=your_qdrant_api_key_here
QDRANT_COLLECTION=rag_documents

# Redis (BullMQ Message Broker for Background PDF Processing)
REDIS_URL=redis://default:your_redis_password@your_redis_host:port

# Queue Names (Separated by environment to prevent cross-server job stealing)
PDF_QUEUE_NAME=pdf-processing-queue-dev
PDF_DLQ_NAME=pdf-processing-dlq-dev

# Allowed Frontend Origins for CORS (comma-separated)
FRONTEND_URL=http://localhost:3000

# Backend Base URL (Used for healthchecks & OAuth redirects)
BACKEND_URL=http://localhost:5000

# DLQ Admin Credentials
ADMIN=admin
PASSWORD=your_secure_password_here

# MongoDB Database & Auth
MONGODB_URI=mongodb://localhost:27017/eideticai
MONGODB_DB_NAME=eideticai
JWT_SECRET=your_jwt_secret_key_here
JWT_EXPIRES_IN=7d

# Google OAuth 2.0 Credentials
GOOGLE_CLIENT_ID=your_google_client_id.apps.googleusercontent.com
GOOGLE_CLIENT_SECRET=your_google_client_secret
GOOGLE_CALLBACK_URL=http://localhost:5000/api/auth/google/callback
